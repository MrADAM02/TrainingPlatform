# Copy this to .env on the SERVER (next to docker-compose.prod.yml, in /opt/trainingplatform) -
# never commit the real file. docker-compose.prod.yml refuses to start if any of the
# required (no-fallback) values below are missing.

# Real Postgres password for the containerized database - not the "postgres_dev_only"
# default the local dev docker-compose.yml uses.
POSTGRES_PASSWORD=

# Signs JWTs issued by the API. Generate one the same way as every other project:
#   openssl rand -base64 48
JWT_KEY=

# Where the frontend is actually served from (the Netlify URL) - CORS rejects everything
# else. Update this + redeploy once the Netlify app has a real URL.
CORS_ORIGIN=https://your-app.netlify.app

# Bootstraps the one real Administrator account on first boot (idempotent - safe to
# leave set on every future deploy, it no-ops once the account exists). There is no
# self-registration in this app, so without these no one could ever log in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Self-hosted MinIO (docker-compose.prod.yml's minio service), standing in for real
# Hetzner Object Storage until that account issue is resolved. ACCESS_KEY/SECRET_KEY
# double as MinIO's root credentials - pick a real random secret, not a placeholder.
# SERVICE_URL must be the public HTTPS domain (lms-storage.jab-eri.org, reverse-proxied
# by nginx), NOT the internal container address - presigned URLs are hit directly by the
# browser, not the API. Create the bucket once MinIO is running with
# backend/scripts/setup-object-storage.sh - see the README's "Deploying to a server"
# section. Switching to real Hetzner Object Storage later is just changing these three
# values + removing the minio service from docker-compose.prod.yml.
STORAGE_BUCKET=training-platform
STORAGE_SERVICE_URL=https://lms-storage.jab-eri.org
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Only needed if you switch to real Hetzner Object Storage and its region/addressing
# differs from the app's defaults (us-east-1 / path-style). Leave unset otherwise.
# STORAGE_REGION=
# STORAGE_FORCE_PATH_STYLE=

# The API image tag to run. CI sets this automatically to sha-<commit> on every deploy;
# only needed here for a manual first-time `docker compose up`.
API_VERSION=latest
