{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TrainingPlatform",
    "Audience": "TrainingPlatform.Client",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "Region": "us-east-1",
    "ForcePathStyle": true
  }
}
